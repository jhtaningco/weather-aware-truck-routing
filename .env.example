# Copy to .env and fill in. Never commit .env.
# Backend reads these from the process environment (docker compose loads .env automatically).

# Django
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Cache: leave empty for in-memory cache; docker compose sets this for the redis service.
REDIS_URL=

# OpenRouteService key (https://openrouteservice.org/dev/#/signup). Needed from Phase 2.
ORS_API_KEY=

# DRF anonymous throttle
THROTTLE_ANON=120/min

# Frontend dev proxy target for /api (docker compose overrides this to http://backend:8000)
VITE_API_PROXY_TARGET=http://localhost:8000
